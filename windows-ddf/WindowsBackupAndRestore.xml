      <DFProperties>
        <AccessType>
          <Get />
        </AccessType>
        <Description>Restore flow entry time.</Description>
        <DFFormat>
          <chr />
        </DFFormat>
        <Occurrence>
          <One />
        </Occurrence>
        <Scope>
          <Permanent />
        </Scope>
        <DFTitle>Restore Flow Time Stamp</DFTitle>
        <DFType>
          <MIME />
        </DFType>
      </DFProperties>
    </Node>
